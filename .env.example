# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Opcional: Diretório customizado para salvar os JSONs e pastas por CNPJ
# Se omitido, o sistema salva automaticamente na pasta ./data dentro do projeto
# DATA_DIR=/var/data/agendamento


# Required in production: long random value used to sign HTTP-only sessions
SESSION_SECRET=replace-with-a-long-random-secret
